# =============================================
# S-liBro Smart Library Management System
# .gitignore — Python/Django + Firebase Hosting
# =============================================

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/

# Virtual Environments (never commit these)
.venv/
venv/
env/
ENV/
*/.venv/
*/venv/

# Django database — never commit this
*.sqlite3
db.sqlite3
db.sqlite3-journal
public/db.sqlite3

# Django uploaded media files
/media/
public/media/

# Django collected static (generated, not source)
staticfiles/
collected_static/

# Django local settings override
local_settings.py

# --- Secrets & Environment Variables ---
.env
.env.local
.env.production
public/.env
!.env.example
!public/.env.example
*.pem
*.key
secrets.json

# --- Firebase ---
.firebase/
firebase-debug.log*
# Keep firebase.json, .firebaseignore, .firebaserc (needed for deploy)

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
*.tgz
.npm
.nyc_output
coverage/

# --- OS & IDE ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- Project specific ---
brain/
*.log
*.bat
public/run_server.bat
public/smart_library_frontend.zip
*.zip

# --- Agent / AI internal files ---
.agents/
.claude/
skills-lock.json
