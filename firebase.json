{
  "hosting": {
    "public": "public/static",
    "ignore": [
      "firebase.json",
      ".firebaseignore",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/.venv/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "smart-library",
          "region": "us-central1"
        }
      }
    ]
  }
}
