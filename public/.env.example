# ========================================================
# S-liBro: Environment Variables Template
# ========================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env   (or 'copy .env.example .env' on Windows)
# 2. Add your Google Gemini API key below.
# 3. Keep .env private and NEVER commit it to source control.

# Google Gemini API Key (Obtain from Google AI Studio free tier: https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model on Free Tier (e.g., gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Django Secret Key (Optional in local dev, required in production)
# DJANGO_SECRET_KEY=your-secret-key-here
